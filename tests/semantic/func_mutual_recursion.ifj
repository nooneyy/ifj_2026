// mutual recursion with written return types is allowed (spec 2.3) -> 0
import ifj26.*

def ping(n: Int): Int =
  if n <= 0 then
    return 0
  else
    return pong(n - 1)

def pong(n: Int): Int =
  if n <= 0 then
    return 0
  else
    return ping(n - 1)

@main def main(): Unit =
  val r = ping(5)
  print(r)
