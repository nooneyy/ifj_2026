// allowed when all branches end with return, checked recursively (spec 2.3 rule 3) -> 0
import ifj26.*

def sign(n: Int): Int =
  if n < 0 then
    return -1
  else if n == 0 then
    return 0
  else
    return 1

@main def main(): Unit =
  print(sign(readInt()))
