// a recursive function needs an explicit return type, lists don't change that
// (spec 2.3, 5.10) -> 6
import ifj26.*

def f(n: Int)(acc: Int) = if n <= 0 then acc else f(n - 1)(acc)

@main def main(): Unit =
  val x = f(3)(0)
