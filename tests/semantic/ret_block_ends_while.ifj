// a block ending with a loop is Unit, the body's value isn't passed on (spec 2.3 rule 2) -> 6
import ifj26.*

def f(): Int =
  var i = 0
  while i < 3 do
    i = i + 1
    i

@main def main(): Unit =
  print(f())
