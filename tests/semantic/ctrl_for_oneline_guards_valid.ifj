// guards after all three range forms, the loop variable is visible in the
// guards (spec 5.3) -> 0
import ifj26.*

@main def main(): Unit =
  val limit = 10
  for i <- 1 to limit if i != 3 do print(i)
  for i <- 0 until limit if i != 3 if i < 8 do print(i)
  for i <- limit to 1 by -2 if i > 2 && i != 6 do
    print(i)
  for i <- 1 to 20 if strLength(toStr(i)) == 2 do print(i)
