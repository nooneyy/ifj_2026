// all builtins with matching arguments and results (spec 4, 5.2) -> 0
import ifj26.*

@main def main(): Unit =
  val line: String = readLine()
  val n: Int = readInt()
  val d: Double = readDouble()
  val b: Boolean = readBoolean()
  val s: String = toStr(n)
  val t: Int = toInt(d)
  val len: Int = strLength(line)
  val part: String = subStr(line, 0, 1)
  val code: Int = ord(line, 0)
  val ch: String = chr(65)
  print(s)
  print(t + len + code)
  print(part + ch)
  print(b)
