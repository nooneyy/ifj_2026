// Int bounds and step, Boolean guards, the variable is Int (spec 5.3) -> 0
import ifj26.*

@main def main(): Unit =
  val limit = readInt()
  for i <- 0 to limit by 2 do
    val n: Int = i
    val d: Double = i
    print(n)
    print(d)
  for i <- 0 until limit do
    print(i)
  for
    j <- limit to 0 by -1
    if j != 3
    if j < limit
  do
    print(j)
