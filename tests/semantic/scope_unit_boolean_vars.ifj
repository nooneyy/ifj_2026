// Unit can be a variable type (spec 1.3), Boolean with BOOLTHEN (spec 5.2) -> 0
import ifj26.*

@main def main(): Unit =
  val u: Unit = ()
  val p = print(1)
  val b: Boolean = 1 < 2
  var c = true
  c = b
  print(u)
  print(p)
  print(c)
