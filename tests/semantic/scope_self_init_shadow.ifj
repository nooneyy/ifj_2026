// the initializer still sees the outer x, the new x is visible only after
// its definition (spec 2.2, team decision) -> 0
import ifj26.*

@main def main(): Unit =
  val x = 1
  val n = readInt()
  if n > 0 then
    val x = x + 1
    print(x)
  else
    val x = toStr(x)
    val s: String = x
    print(s)
  val back: Int = x
  print(back)
