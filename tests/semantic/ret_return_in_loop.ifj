// return ends the function even from a loop (spec 2.3 rule 1) -> 0
import ifj26.*

def root(n: Int): Int =
  var i = 0
  while i < n do
    if i * i == n then
      return i
    i = i + 1
  return -1

@main def main(): Unit =
  print(root(16))
