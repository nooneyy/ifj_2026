// explicit Unit, or no type with all branches Unit (spec 2.3 rule 3) -> 0
import ifj26.*

def show(n: Int): Unit =
  if n < 0 then
    print("neg")

def show2(n: Int) =
  if n < 0 then
    print("neg")
  else
    print("pos")

@main def main(): Unit =
  show(1)
  val u: Unit = show2(1)
  print(u)
