// a variable is visible in all sub-blocks and can be assigned there (spec 2.2) -> 0
import ifj26.*

@main def main(): Unit =
  var total = 0
  var i = 0
  while i < 3 do
    if i != 1 then
      total = total + i
    else
      print(i)
    i = i + 1
  print(total)
