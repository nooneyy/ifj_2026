// one Double operand makes the result Double (spec 3) -> 0
import ifj26.*

@main def main(): Unit =
  val i = 7
  val d: Double = i + 0.5
  val e: Double = 7 / 2 + 0.5
  val f: Double = 2.0 * i - 1
  val g: Double = i / 2.0
  val h: Double = -d
  print(d + e + f + g + h)
