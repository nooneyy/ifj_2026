// with explicit Unit the value is thrown away, even with return (spec 2.3 rule 4) -> 0
import ifj26.*

def body_value(): Unit = 5

def return_value(): Unit =
  return 5

@main def main(): Unit =
  val u: Unit = body_value()
  val v: Unit = return_value()
  print(u)
  print(v)
