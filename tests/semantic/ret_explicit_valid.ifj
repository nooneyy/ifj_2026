// one-line body, block ending in an expression or call, Int for Double (spec 2.3) -> 0
import ifj26.*

def one(): Int = 1

def half(): Double = 1

def name(): String =
  val s = "a"
  s + "b"

def last_call(): Int =
  print(1)
  readInt()

def ret_double(): Double =
  return 1

@main def main(): Unit =
  val a: Int = one()
  val b: Double = half()
  val c: String = name()
  val d: Int = last_call()
  val e: Double = ret_double()
  print(a + d)
  print(b + e)
  print(c)
