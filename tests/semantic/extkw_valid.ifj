// the spec example with the result types, methods used before their
// definition, the same name for different types, a method using another
// method of its receiver and an Int argument widened to a Double parameter
// (spec 1.3, 5.9) -> 0
import ifj26.*
@main def main(): Unit =
  val x: Int = 6
  val y: Int = x.twice
  val z: String = x.foo()
  val w: Int = x.plus(12)
  val s: String = "ab".twice
  val q: Int = x.quad
  val d: Double = 1.5.scale(2)
  val b: Boolean = x.isSmall
  print(y)

extension (value: Int)
  def twice: Int = value * 2
  def foo(): String = "foo" + value.toString
  def plus(other: Int): Int = value + other
  def quad = value.twice.twice
  def isSmall: Boolean = value < 10

extension (text: String)
  def twice: String = text + text

extension (d: Double)
  def scale(factor: Double): Double = d * factor
