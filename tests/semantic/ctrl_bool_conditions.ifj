// any Boolean expression can be a condition (spec 5.2) -> 0
import ifj26.*

@main def main(): Unit =
  val ok = readBoolean()
  var i = 0
  if ok then
    print(1)
  while ok && i < 3 do
    i = i + 1
  if !ok || i == 3 then
    print(2)
