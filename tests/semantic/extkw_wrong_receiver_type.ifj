// a method exists only for the type of its receiver, twice isn't defined
// for String (spec 5.9, 6) -> 3
import ifj26.*
extension (value: Int)
  def twice: Int = value * 2
@main def main(): Unit =
  val s = "ab"
  val t = s.twice
