// calls matching the definition list by list, before the definition too, with
// Int arguments widened to Double and inferred return types (spec 1.3, 2.3,
// 5.10) -> 0
import ifj26.*

@main def run(): Unit =
  val x = answer
  val y = answerWithParens()
  val sum = add(x)(y)(1)
  val result = offset()(sum)
  val d: Double = scale(2)(3)
  val s: String = greeting + "!"
  val n: Int = inferred(1)(2) * answer
  print(result)

def answer: Int = 42
def answerWithParens(): Int = 42
def add(a: Int)(b: Int)(c: Int): Int = a + b + c
def offset()(value: Int): Int = value + 1
def scale(x: Double)(factor: Double): Double = x * factor
def greeting = "hi"
def inferred(a: Int)(b: Int) = a + b
