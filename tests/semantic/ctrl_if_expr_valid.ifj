// same branch types, or Int and Double with conversion (spec 5.3) -> 0
import ifj26.*

@main def main(): Unit =
  val n = readInt()
  val a: Int = if n < 0 then 0 - n else n
  val d: Double = if n < 0 then 1 else 2.5
  val s: String = if n < 0 then "neg" else if n == 0 then "zero" else "pos"
  val y: Int = 1 + (if n < 0 then 1 else 2)
  val v: Int = if n < 0 then
    val t = 0 - n
    t * 2
  else
    n
  print(a + y + v)
  print(d)
  print(s)
