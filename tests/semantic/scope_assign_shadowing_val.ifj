// the inner val hides the outer var, so x = 3 writes to the val (spec 2.2) -> 7
import ifj26.*

@main def main(): Unit =
  var x = 1
  val n = readInt()
  if n > 0 then
    val x = 2
    x = 3
    print(x)
  else
    x = 4
  print(x)
