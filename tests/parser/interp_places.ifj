// an interpolated string is an expression, so it can be anywhere an
// expression can: initialization, assignment, function body, return,
// argument, operand, parentheses, if-expression branch (spec 5.6) -> 0
import ifj26.*
def greet(name: String): String = s"Hello $name"
def label(n: Int): String =
  return s"n = $n"
@main def main(): Unit =
  val n = 26
  var t: String = s"first"
  t = s"second $n"
  print(greet(s"IFJ$n"))
  val sum = s"$n" + s"${n + 1}" + "plain"
  val par = (s"in $n") + t
  val cond = if n > 1 then s"big $n" else s"small"
  if s"$n" == "26" then
    print(s"equal")
  print(label(n))
