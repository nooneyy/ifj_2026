// * and / before + and -, those before relational, those before == and != -> 0
import ifj26.*
@main def main(): Unit =
  val a = 1
  val b = 2
  val c = 3
  val d = 4
  val p1 = a + b * c
  val p2 = a * b + c
  val p3 = a + b < c * d
  val p4 = a < b == c > d
  val p5 = a - b / c + d
