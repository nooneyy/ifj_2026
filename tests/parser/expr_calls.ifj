// calls nested in expressions, any expression as an argument -> 0
import ifj26.*
def add(a: Int, b: Int): Int = a + b

@main def main(): Unit =
  val x = 1
  val c1 = add(x, x + 1)
  val c2 = add(add(1, 2), -x)
  val c3 = 2 * add(x, 3) - 1
  print(toStr(add(x, 1)))
