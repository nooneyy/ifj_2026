// the argument lists may span lines, a trailing comma is allowed in any of them
// when ')' is on the next line (spec 1.2, 5.10) -> 0
import ifj26.*

def add(a: Int)(b: Int, c: Int): Int = a + b + c

@main def main(): Unit =
  val x = add(
      1,
    )(
      2,
      3,
    )
  val y = add(1)(
      2, 3
    )
