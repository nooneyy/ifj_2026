// members in for ranges and guards, conditions, call arguments, function
// bodies and return; a range or guard still ends at until, by, if and do after
// a member (spec 5.3, 5.4) -> 0
import ifj26.*
def len(s: String) = s.length
def lastFloor(d: Double): Double =
  val x = d * 2.0
  x.floor
def early(d: Double): Double =
  return d.floor
@main def main(): Unit =
  val s = "abcd"
  for i <- 0 until s.length do print(i)
  for i <- 0 to s.length by s.length.toString.length if i != s.length do print(i)
  if s.length > 2 then print(s.length)
  var t = s
  while t.length > 1 do
    t = subStr(t, 1, t.length)
  print(toStr(len(s)).length)
