// to, until, by and main aren't keywords, so they can name variables -> 0
import ifj26.*
@main def main(): Unit =
  val to = 3
  val until = 1
  val by = 2
  val main = 0
  print(until + by + main)
  for i <- 1 to to do
    print(i)
