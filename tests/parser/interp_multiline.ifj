// multi-line interpolated strings: the double quote is written literally,
// line ends belong to the text, $id, ${expr} and $$ work like in the
// one-line ones (spec 5.6) -> 0
import ifj26.*
@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  val empty = s""""""
  val quotes = s""""$name" ${n}"""
  val lines = s"""$n
${n * 2}
$$"""
  print(lines)
