// one-line bodies instead of blocks, mixed with blocks -> 0
import ifj26.*
@main def main(): Unit =
  val x = readInt()
  if x < 0 then print(1) else print(2)
  if x < 0 then print(1) else if x == 0 then print(2) else print(3)
  if x < 0 then print(1) else
    print(2)
  if x < 0 then
    print(1)
  else print(2)
