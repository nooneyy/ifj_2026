PROGRAM
  FUNC_DEF main @main () : Unit
    BLOCK
      VAR_DEF val x : ?
        CALL readInt
      IF stmt
        cond:
          BINARY_OP <
            VAR_REF x
            LITERAL Int 5
        then:
          BLOCK
            CALL print
              LITERAL String "small"
        else:
          BLOCK
            IF stmt
              cond:
                BINARY_OP ==
                  VAR_REF x
                  LITERAL Int 5
              then:
                BLOCK
                  LITERAL Unit
              else:
                BLOCK
                  CALL print
                    LITERAL String "big"
