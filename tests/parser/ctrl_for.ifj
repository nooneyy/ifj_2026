// to, until, by, expressions as bounds and step -> 0
import ifj26.*
@main def main(): Unit =
  val n = 10
  for i <- 1 to 10 by 2 do
    print(i)
  for i <- 0 until n do
    print(i)
  for i <- n - 1 to readInt() + 1 by -1 do
    print(i)
  for i<-1 to 3 do
    print(i)
