// ! above *, && below relational, || below && -> 0
import ifj26.*
@main def main(): Unit =
  val a = true
  val b = false
  val c = true
  val o1 = !a && b || c
  val o2 = a || b && c
  val o3 = !(1 < 2)
  val o4 = a == b && b != c
  val o5 = a || b || c
  val o6 = !!a
  val o7 = 1 < 2 && a
  val o8 = !a == b
