// a guard may follow a to ... by range in the one-line header, also with a
// negative step -> 0
import ifj26.*
@main def main(): Unit =
  for i <- 1 to 10 by 2 if i != 5 do print(i)
  for i <- 10 to 1 by -3 if i != 7 do print(i)
