// else if aligned with if, with and without a final else -> 0
import ifj26.*
@main def main(): Unit =
  val x = readInt()
  if x < 0 then
    print("negative")
  else if x == 0 then
    print("zero")
  else
    print("positive")
  if x < 10 then
    print("small")
  else if x < 100 then
    print("medium")
