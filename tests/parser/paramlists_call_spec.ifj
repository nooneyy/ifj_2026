// the example from the spec: a call without a list, with one empty list, with
// several lists and with an empty first list (spec 5.10) -> 0
import ifj26.*

def answer: Int = 42
def answerWithParens(): Int = 42
def add(a: Int)(b: Int)(c: Int): Int = a + b + c
def offset()(value: Int): Int = value + 1

@main def run(): Unit =
  val x = answer
  val y = answerWithParens()
  val sum = add(x)(y)(1)
  val result = offset()(sum)
  print(result) // vypise 86
