// unary minus binds tighter than binary operators, binary minus after ) -> 0
import ifj26.*
@main def main(): Unit =
  val a = 1
  val b = 2
  val u1 = -a
  val u2 = a - -b
  val u3 = - -a
  val u4 = -a * b
  val u5 = -(a + b)
  val u6 = 2 * -3
  val u7 = readInt() - 1
  val u8 = (a) - b
