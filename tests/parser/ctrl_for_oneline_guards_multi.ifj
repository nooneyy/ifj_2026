// any number of guards in the one-line header, Boolean operators and calls
// inside guards, a block body after do -> 0
import ifj26.*
@main def main(): Unit =
  val limit = 10
  for i <- 0 until limit if i != 3 if i < 8 do print(i)
  for i <- 1 to limit by 2 if i > 1 && i < 9 if !(i == 5) do
    print(i)
    print("\n")
  for i <- 5 to 15 if strLength(toStr(i)) == 1 do print(i)
