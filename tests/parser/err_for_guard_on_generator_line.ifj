// in the multi-line header each generator and each guard is on its own logical
// line (spec 1.2 and 5.3), so a guard can't follow the generator -> 2
import ifj26.*
@main def main(): Unit =
  for
    i <- 1 to 10 if i != 3
  do
    print(i)
