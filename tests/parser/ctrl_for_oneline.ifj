// the body may follow do on the same line in both header forms -> 0
import ifj26.*
@main def main(): Unit =
  for i <- 1 to 5 do print(i)
  for
    i <- 1 to 5
  do print(i)
  for i <- 1 to 3 do print(if i < 2 then "a" else "b")
