// text, $id, ${expr} and $$ in every order: a string without parts is "",
// one part stays alone, more parts are joined with + from the left (spec 5.6)
// -> 0
import ifj26.*
@main def main(): Unit =
  val x = 1
  val empty = s""
  val text = s"just text"
  val dollar = s"$$"
  val id = s"$x"
  val expr = s"${x}"
  val front = s"$x is first"
  val back = s"last is $x"
  val middle = s"a $x b"
  val glued = s"$x$x${x}"
  val dollars = s"$$$x$$"
