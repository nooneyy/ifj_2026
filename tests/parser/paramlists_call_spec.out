PROGRAM
  FUNC_DEF answer : Int
    LITERAL Int 42
  FUNC_DEF answerWithParens () : Int
    LITERAL Int 42
  FUNC_DEF add (a: Int)(b: Int)(c: Int) : Int
    BINARY_OP +
      BINARY_OP +
        VAR_REF a
        VAR_REF b
      VAR_REF c
  FUNC_DEF offset ()(value: Int) : Int
    BINARY_OP +
      VAR_REF value
      LITERAL Int 1
  FUNC_DEF run @main () : Unit
    BLOCK
      VAR_DEF val x : ?
        VAR_REF answer
      VAR_DEF val y : ?
        CALL answerWithParens
      VAR_DEF val sum : ?
        CALL add (1)(1)(1)
          VAR_REF x
          VAR_REF y
          LITERAL Int 1
      VAR_DEF val result : ?
        CALL offset (0)(1)
          VAR_REF sum
      CALL print
        VAR_REF result
