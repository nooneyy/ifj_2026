// generator and guards on their own lines, do aligned with for -> 0
import ifj26.*
@main def main(): Unit =
  val limit = 10
  for
    i <- 0 until limit
    if i != 3
    if i < 8
  do
    print(i)
  for
    j <- 1 to 3
    if j != 2
  do print(j)
