import ifj26.*

def answer: Int = 42
def add(a: Int)(b: Int): Int = a + b
def flag()(n: Int): Boolean = n > 0
def body(a: Int)(b: Int) = add(a)(b)
def early(a: Int)(b: Int): Int =
  return add(a)(b)

@main def main(): Unit =
  val a = add(1)(2)
  var b = answer
  b = add(b)(answer)
  add(3)(4)
  answer
  add(5)(6); answer
  if flag()(b) then
    print(b)
  while flag()(b - 100) && answer > 0 do
    b = b - 1
  for i <- add(0)(1) to add(answer)(1) do
    print(i)
  print(add(add(1)(2))(answer))
