// a comment counts as an end of line, also right after a block header -> 0
import ifj26.*
@main def main(): Unit = // after =
  var x = 1 /* block comment
  with a line break */
  if x < 2 then // after then
    x = 2
  else // after else
    x = 3
  while x < 5 do // after do
    x = x + 1
  for // after for
    i <- 0 until 3 // after the generator
    // on its own line inside the header
    if i != 1 // after the guard
  do // after do
    print(i)
