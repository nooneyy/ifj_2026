// the example from the spec: $id, ${expr} and $$ in a one-line interpolated
// string, a multi-line interpolated string with a literal double quote
// (spec 5.6) -> 0
import ifj26.*
@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  // IFJ27 costs $0
  print(s"$name${n + 1} costs $$0")
