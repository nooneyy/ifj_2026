// a member binds tighter than every operator: -d.floor is -(d.floor) and
// 1 + s.length * 2 is 1 + ((s.length) * 2), a minus after a member is binary
// (spec 5.4) -> 0
import ifj26.*
@main def main(): Unit =
  val d = 2.5
  val s = "abc"
  val a = -d.floor
  val b = 1 + s.length * 2
  val c = s.length - 1
  val e = d.floor + 0.5
  val f = s.length == 3
  val g = d.toInt / 2 < s.length
