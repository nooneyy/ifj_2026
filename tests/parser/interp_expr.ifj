// ${ } holds any expression the compiler supports: operators, parentheses,
// unary operators, literals, function calls (FUNEXP) and if (CONTROL)
// (spec 5.6) -> 0
import ifj26.*
def twice(a: Int): Int = a * 2
@main def main(): Unit =
  val a = 1
  val b = 3
  print(s"sum ${a + b * (a - 3)}")
  print(s"neg ${-a} and not ${!(a < 2)}")
  print(s"cmp ${a <= 2 && a != 0}")
  print(s"lit ${1.2345} ${"text"} ${true}")
  print(s"call ${twice(a)} ${toStr(a)}")
  print(s"if ${if a > 0 then a else 0}")
  print(s"spaced ${ a } out")
