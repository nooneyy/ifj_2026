PROGRAM
  FUNC_DEF main @main () : Unit
    BLOCK
      VAR_DEF val x : ?
        CALL readInt
      IF stmt
        cond:
          BINARY_OP <
            VAR_REF x
            LITERAL Int 0
        then:
          CALL print
            VAR_REF x
        else:
          IF stmt
            cond:
              BINARY_OP ==
                VAR_REF x
                LITERAL Int 0
            then:
              CALL print
                LITERAL Int 0
            else:
              CALL print
                VAR_REF x
