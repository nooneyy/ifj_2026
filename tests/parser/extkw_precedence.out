PROGRAM
  FUNC_DEF twice [value: Int] : Int
    BINARY_OP *
      VAR_REF value
      LITERAL Int 2
  FUNC_DEF plus [value: Int] (other: Int) : Int
    BINARY_OP +
      VAR_REF value
      VAR_REF other
  FUNC_DEF flip [b: Boolean] : Boolean
    UNARY_OP !
      VAR_REF b
  FUNC_DEF main @main () : Unit
    BLOCK
      VAR_DEF val x : ?
        LITERAL Int 3
      VAR_DEF val t : ?
        LITERAL Boolean true
      VAR_DEF val a : ?
        UNARY_OP -
          VALMEM_FIELD twice
            VAR_REF x
      VAR_DEF val b : ?
        BINARY_OP +
          LITERAL Int 1
          BINARY_OP *
            VALMEM_FIELD plus (1)
              VAR_REF x
              LITERAL Int 2
            LITERAL Int 3
      VAR_DEF val c : ?
        BINARY_OP -
          VALMEM_FIELD twice
            VAR_REF x
          LITERAL Int 1
      VAR_DEF val d : ?
        UNARY_OP !
          VALMEM_FIELD flip
            VAR_REF t
      VAR_DEF val e : ?
        BINARY_OP &&
          BINARY_OP ==
            VALMEM_FIELD plus (1)
              VAR_REF x
              LITERAL Int 1
            VALMEM_FIELD twice
              VAR_REF x
          VALMEM_FIELD flip
            VAR_REF t
      VAR_DEF val f : ?
        BINARY_OP <
          BINARY_OP /
            VALMEM_FIELD twice
              VAR_REF x
            LITERAL Int 2
          VALMEM_FIELD plus (1)
            VAR_REF x
            LITERAL Int 1
