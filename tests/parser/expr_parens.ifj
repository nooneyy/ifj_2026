// parentheses override priority, line breaks inside them are whitespace -> 0
import ifj26.*
@main def main(): Unit =
  val a = 1
  val b = 2
  val c = 3
  val r1 = ((a))
  val r2 = (a + b) * c
  val r3 = a * (b + c)
  val r4 = (a +
    b) * (c -
      a)
