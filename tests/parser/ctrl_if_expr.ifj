// the spec's three layouts, else if, if as an argument and in parentheses -> 0
import ifj26.*
@main def main(): Unit =
  var x = -5
  val absolute = if x < 0 then 0 - x else x
  val abs2 = if x < 0 then
    0 - x
  else
    x
  val abs3 = if x < 0 then 0 - x else
      x
  val sign = if x < 0 then -1 else if x == 0 then 0 else 1
  print(if x < 0 then "neg" else "pos")
  val y = 1 + (if x < 0 then 1 else 2)
