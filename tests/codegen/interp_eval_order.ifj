// the inserted expressions are evaluated from left to right, before the
// string is printed (spec 3, 5.1, 5.6) -> aba|1-2-1
import ifj26.*

def a(): Int =
  print("a")
  1

def b(): Int =
  print("b")
  2

@main def main(): Unit =
  val s = s"${a()}-${b()}-${a()}"
  print("|")
  print(s)
  print("\n")
