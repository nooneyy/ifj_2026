// print writes true or false, relations give Boolean (spec 5.2)
import ifj26.*

@main def main(): Unit =
  print(true)
  print(" ")
  print(false)
  print(" ")
  val b = 3 < 5
  print(b)
  print(" ")
  val c: Boolean = 2.5 == 2.5
  print(c)
  print("\n")
