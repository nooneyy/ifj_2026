// for every value the guards run from left to right and stop at the first
// false one, the body runs only if all pass (spec 5.3, like Scala's
// withFilter) -> ab1 a ab ab4 = ab1aabab4
import ifj26.*

def first(i: Int): Boolean =
  print("a")
  i != 2

def second(i: Int): Boolean =
  print("b")
  i != 3

@main def main(): Unit =
  for i <- 1 to 4 if first(i) if second(i) do print(i)
  print("\n")
