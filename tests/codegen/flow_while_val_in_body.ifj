// a val in the body is defined again in every iteration (spec 2.2, 2.5)
import ifj26.*

@main def main(): Unit =
  var i = 0
  while i < 3 do
    val sq = i * i
    print(sq)
    print(" ")
    i = i + 1
  print("\n")
