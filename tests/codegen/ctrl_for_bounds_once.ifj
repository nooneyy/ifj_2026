// bounds are evaluated exactly once before the first iteration (spec
// 5.3, with FUNEXP for the call) -> 123 6, b012
import ifj26.*

def bound(): Int =
  print("b")
  2

@main def main(): Unit =
  var n = 3
  for i <- 1 to n do
    n = n + 1
    print(i)
  print(" ")
  print(n)
  print("\n")
  for i <- 0 to bound() do
    print(i)
  print("\n")
