// toString works like toStr for every type, Double with two decimals
// (spec 5.4) -> 42, 1.23, -2.50, abc, true, false, (), 43
import ifj26.*

@main def main(): Unit =
  val i = 42
  val d = 1.2345
  val n = -2.5
  print(i.toString + "\n")
  print(d.toString + "\n")
  print(n.toString + "\n")
  print("abc".toString + "\n")
  print(true.toString + "\n")
  print((i > 50).toString + "\n")
  print(().toString + "\n")
  print((i + 1).toString + "\n")
