// toInt cuts off the decimal part, also for negative values, and gives an Int
// (spec 4, 5.4) -> 3, -3, 0, 2, 1000, 4
import ifj26.*

@main def main(): Unit =
  val a = 3.7
  val b = -3.7
  val c = 0.5
  val d = 2.0
  val e = 1e3
  print(a.toInt)
  print("\n")
  print(b.toInt)
  print("\n")
  print(c.toInt)
  print("\n")
  print(d.toInt)
  print("\n")
  print(e.toInt)
  print("\n")
  print(a.toInt + 1)
  print("\n")
