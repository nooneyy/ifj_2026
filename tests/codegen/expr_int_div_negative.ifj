// Int division is integral and rounds toward zero (spec 3) -> -3, -3, 3
import ifj26.*

@main def main(): Unit =
  val a = -7
  val b = 2
  val m = -2
  val c = a / b
  val d = 7 / m
  val e = a / m
  print(c)
  print("\n")
  print(d)
  print("\n")
  print(e)
  print("\n")
