// if as an expression in all forms from the spec (spec 5.3) -> 555
import ifj26.*

@main def main(): Unit =
  var x = -5
  val absolute = if x < 0 then 0 - x else x
  print(absolute)
  val abs2 = if x < 0 then
    0 - x
  else
    x
  print(abs2)
  val abs3 = if x < 0 then 0 - x else
      x
  print(abs3)
  print("\n")
