 * (context: codegen tests for the INTERPOLATEDS extension (spec 5.6); every
 * program is compiled by codegen_main, run by ic26int and its output and return
 * code are compared; every inserted value is converted the same way as by
 * toStr, so a Double is written with "%.2f" (spec 4, 5.6))
 */
// escape sequences work like in normal strings, a double quote is \", $$ is
// one dollar, also right before $id (spec 1.1, 5.6)
// -> quote "IFJ" tab[TAB]here back\slash, $5 $IFJ $name
import ifj26.*

@main def main(): Unit =
  val name = "IFJ"
  val price = 5
  print(s"quote \"$name\" tab\there back\\slash\n")
  print(s"$$$price $$$name $$name\n")
