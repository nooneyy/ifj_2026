// a call can be an operand of a condition (spec 5.1) -> long5
import ifj26.*

@main def main(): Unit =
  val s = "hello"
  if strLength(s) > 3 then
    print("long")
  else
    print("short")
  var i = 0
  while i < strLength(s) do
    i = i + 1
  print(i)
  print("\n")
