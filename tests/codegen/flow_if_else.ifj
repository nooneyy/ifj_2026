// the first branch runs for a true condition, the else branch otherwise
// (spec 2.4) -> small, small
import ifj26.*

@main def main(): Unit =
  val x = 3
  if x < 5 then
    print("small")
  else
    print("big")
  print("\n")
  if x > 5 then
    print("big")
  else
    print("small")
  print("\n")
