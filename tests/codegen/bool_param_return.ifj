// Boolean can be passed, returned and stored (spec 5.2)
// -> false false true true
import ifj26.*

def negate(b: Boolean): Boolean = !b

def isPositive(x: Int): Boolean = x > 0

@main def main(): Unit =
  val m = -3
  val a = negate(true)
  val c = isPositive(m)
  val d = isPositive(4)
  var flag = false
  flag = d
  print(a)
  print(" ")
  print(c)
  print(" ")
  print(d)
  print(" ")
  print(flag)
  print("\n")
