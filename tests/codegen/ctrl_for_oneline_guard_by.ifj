// a guard after to ... by ranges with a positive and a negative step
// (spec 5.3) -> 1379, then 1041 (10, 4, 1)
import ifj26.*

@main def main(): Unit =
  for i <- 1 to 10 by 2 if i != 5 do print(i)
  print("\n")
  for i <- 10 to 1 by -3 if i != 7 do print(i)
  print("\n")
