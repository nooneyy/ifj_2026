// the Int branch is converted when the other one is Double (spec 5.3)
// -> 1.0 2.5
import ifj26.*

@main def main(): Unit =
  val n = 1
  val d = if n > 0 then 1 else 2.5
  val e = if n < 0 then 1 else 2.5
  print(d)
  print(" ")
  print(e)
  print("\n")
