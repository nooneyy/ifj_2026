// floor rounds down to a whole number and stays a Double, negative values go
// away from zero (spec 5.4) -> 3.0, -4.0, -3.0, 0.0, -1.0, 7.0 printed as %a
import ifj26.*

@main def main(): Unit =
  val a = 3.7
  val b = -3.7
  val c = -3.0
  val d = 0.5
  val e = -0.5
  print(a.floor)
  print("\n")
  print(b.floor)
  print("\n")
  print(c.floor)
  print("\n")
  print(d.floor)
  print("\n")
  print(e.floor)
  print("\n")
  print((7.0).floor)
  print("\n")
