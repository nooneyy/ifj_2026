// the last expression of the body is the return value (spec 2.3) -> 9
import ifj26.*

def calc(x: Int): Int =
  val y = x + 1
  val z = y * 2
  z - 1

@main def main(): Unit =
  val r = calc(4)
  print(r)
  print("\n")
