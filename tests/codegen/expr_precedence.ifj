// unary - over * / over + -, left associativity, parentheses (spec 3)
import ifj26.*

@main def main(): Unit =
  val a = 2 + 3 * 4
  val b = (2 + 3) * 4
  val c = 10 - 4 - 3
  val d = 100 / 10 / 5
  val e = -2 * 3
  val f = -(2 + 3) + 1
  val g = 2 * (3 + 4) - 10 / (1 + 1)
  print(a)
  print("\n")
  print(b)
  print("\n")
  print(c)
  print("\n")
  print(d)
  print("\n")
  print(e)
  print("\n")
  print(f)
  print("\n")
  print(g)
  print("\n")
