// arguments are evaluated from left to right, from the first list to the last,
// and only then the body runs (spec 5.10) -> abcd|body|10
import ifj26.*

def tag(label: String)(value: Int): Int =
  print(label)
  value

def sum(a: Int)(b: Int, c: Int)(d: Int): Int =
  print("|body|")
  a + b + c + d

@main def main(): Unit =
  print(sum(tag("a")(1))(tag("b")(2), tag("c")(3))(tag("d")(4)))
  print("\n")
