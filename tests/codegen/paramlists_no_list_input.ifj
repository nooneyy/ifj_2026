// next reads a new line on every use, nothing is cached (spec 4, 5.10) -> 10 +
// 2 + 3 = 15
import ifj26.*

def next: Int = readInt()

@main def main(): Unit =
  val a = next
  val b = next
  print(a * 10 + b + next)
  print("\n")
