// nested calls in expressions and arguments with 3 on the input
// (spec 5.1) -> 2 * 4! + strLength("bc") = 50
import ifj26.*

def factorial(n: Int): Int =
  var result = 1
  var i: Int = n
  while i > 1 do
    result = result * i
    i = i - 1
  result

@main def main(): Unit =
  val result = 2 * factorial(readInt() + 1)
  print(toStr(result + strLength(subStr("abcd", 1, 3))))
