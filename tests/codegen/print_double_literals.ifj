// exponent, missing integer part, suffix d, underscores, leading zeros
// in the exponent (spec 1.1, forum) -> values in the %a format
import ifj26.*

@main def main(): Unit =
  print(1e3)
  print("\n")
  print(.5)
  print("\n")
  print(2.5d)
  print("\n")
  print(1_0.5)
  print("\n")
  print(2e001)
  print("\n")
  print(2E-1)
  print("\n")
