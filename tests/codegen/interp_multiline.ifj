// a multi-line interpolated string holds its line ends and double quotes
// literally, $id, ${expr} and $$ work like in the one-line ones, an empty
// one prints nothing (spec 1.1, 5.6)
// -> He said "hi" to IFJ[new line]  indented 52[new line]$ end, ""
import ifj26.*

@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  print(s"""He said "hi" to $name
  indented ${n * 2}
$$ end""")
  print("\n")
  print(s"""""")
  print(s"""""$name""")
  print("\n")
