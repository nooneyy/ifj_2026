// Int to Double for an argument and for a returned value (spec 1.3, 2.3)
// -> 1.5, 2.0
import ifj26.*

def half(x: Double): Double = x / 2.0

def two(): Double = 2

@main def main(): Unit =
  val a = half(3)
  print(a)
  print("\n")
  val b = two()
  print(b)
  print("\n")
