// + - * / over Double values (spec 3) -> 3.75, 4.5, 3.0, 0.25, 1/3
import ifj26.*

@main def main(): Unit =
  val a = 1.5 + 2.25
  val b = 5.0 - 0.5
  val c = 1.5 * 2.0
  val d = 1.0 / 4.0
  val e = 1.0 / 3.0
