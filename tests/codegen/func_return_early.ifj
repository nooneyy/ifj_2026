// return ends the function at once, also from a nested branch or loop
// (spec 2.3) -> 8, -1
import ifj26.*

def firstAbove(limit: Int): Int =
  var i = 0
  while i < 100 do
    if i * i > limit then
      return i
    else
      ()
    i = i + 1
  return -1

@main def main(): Unit =
  val a = firstAbove(50)
  val b = firstAbove(100000)
  print(a)
  print("\n")
  print(b)
  print("\n")
