// return ends the function also from a for loop (spec 2.3, 5.3) -> 7 -1
import ifj26.*

def find(target: Int): Int =
  for i <- 0 to 100 do
    if i * i == target then
      return i
  return -1

@main def main(): Unit =
  val a = find(49)
  val b = find(50)
  print(a)
  print(" ")
  print(b)
  print("\n")
