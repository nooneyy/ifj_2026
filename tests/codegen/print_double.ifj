// print writes Double like WRITE with %a (spec 4, 7.4.4)
import ifj26.*

@main def main(): Unit =
  print(2.5)
  print("\n")
  print(1.0)
  print("\n")
  print(0.1)
  print("\n")
  val neg = -2.5
  print(neg)
  print("\n")
  print(0.0)
  print("\n")
