// the factorial program from the specification with 5 on the input
// (spec 2) -> 120
import ifj26.*

def factorial(n: Int): Int =
  var result = 1
  var i: Int = n // uvedeni typu je nepovinne
  while i > 1 do
    result = result * i
    i = i - 1
  result // posledni vyraz v tele funkce urci navratovou hodnotu

@main def runFoo(): Unit =
  val n = readInt()
  val result = factorial(n)
  print(result)
  print("\n")
