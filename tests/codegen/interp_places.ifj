// an interpolated string is a String expression: it can be returned,
// passed, assigned in a loop, compared, used in an if-expression and as an
// operand of + (spec 5.1, 5.3, 5.6)
// -> Hello, IFJ!|1,2,3,|big 4|len 4|equal|ab4
import ifj26.*

def greet(name: String): String = s"Hello, $name!"

def size(text: String): Int = strLength(text)

@main def main(): Unit =
  print(greet("IFJ"))
  print("|")
  var acc = ""
  var i = 1
  while i <= 3 do
    acc = s"$acc$i,"
    i = i + 1
  print(acc)
  print("|")
  val big = if i > 2 then s"big $i" else s"small $i"
  print(big)
  print("|")
  print(s"len ${size(s"abc$i")}")
  print("|")
  if s"$i" == "4" then
    print("equal")
  else
    print("different")
  print("|")
  val joined = "a" + s"b$i"
  print(joined)
  print("\n")
