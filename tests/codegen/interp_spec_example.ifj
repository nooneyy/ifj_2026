// the example from the spec (spec 5.6)
// -> IFJ27 costs $0, He said "hello", IFJ.[new line]Second line.
import ifj26.*

@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  // IFJ27 costs $0
  print(s"$name${n + 1} costs $$0")
  print("\n")
  // He said "hello", IFJ.[novy radek]Second line.
  print(s"""He said "hello", $name.
Second line.""")
  print("\n")
