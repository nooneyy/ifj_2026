// calls chain with each other and with VALMEM members, an argument can be
// a method call too (spec 5.9, 5.4) -> 12|8|12|7|1
import ifj26.*

extension (n: Int)
  def twice: Int = n * 2
  def plus(other: Int): Int = n + other

@main def main(): Unit =
  val x = 3
  print(x.twice.twice)
  print("|")
  print(x.plus(1).twice)
  print("|")
  print(x.twice.plus(x.twice))
  print("|")
  print(x.plus(x.plus(1)))
  print("|")
  print(x.twice.toString.length)
  print("\n")
