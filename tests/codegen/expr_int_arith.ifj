// + - * / over two Int values give Int (spec 3) -> 9, 5, 14, 3
import ifj26.*

@main def main(): Unit =
  val a = 7
  val b = 2
  val sum = a + b
  val diff = a - b
  val prod = a * b
  val quot = a / b
  print(sum)
  print("\n")
  print(diff)
  print("\n")
  print(prod)
  print("\n")
  print(quot)
  print("\n")
