// any valid identifier can name a function, even one resembling builtins
// or generated labels (spec 1.1, 2.3) -> 2 7 w
import ifj26.*

def ifj_print(x: Int): Int = x + 1

def else_0(): Int = 7

def while_end_0(): String = "w"

@main def main(): Unit =
  val a = ifj_print(1)
  val b = else_0()
  val c = while_end_0()
  print(a)
  print(" ")
  print(b)
  print(" ")
  print(c)
  print("\n")
