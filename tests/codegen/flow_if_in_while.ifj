// branches chosen anew in every iteration (spec 2.4, 2.5) -> oeoeoe
import ifj26.*

@main def main(): Unit =
  var i = 1
  while i <= 6 do
    val half = i / 2
    val twice = half * 2
    if twice == i then
      print("e")
    else
      print("o")
    i = i + 1
  print("\n")
