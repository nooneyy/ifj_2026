// operands and arguments are evaluated from left to right (spec 3, 5.1)
// -> ab3ba3aba3
import ifj26.*

def a(): Int =
  print("a")
  1

def b(): Int =
  print("b")
  2

def add(x: Int, y: Int): Int = x + y

@main def main(): Unit =
  val s = a() + b()
  print(s)
  val t = add(b(), a())
  print(t)
  val u = a() * (b() + a())
  print(u)
  print("\n")
