// Int arguments are widened to Double in any list (spec 1.3, 5.10) -> 3.00,
// 7.00
import ifj26.*

def scale(x: Double)(factor: Double): Double = x * factor
def mix(a: Int)(b: Double, c: Int): Double = a + b * c

@main def main(): Unit =
  print(toStr(scale(2)(1.5)))
  print("\n")
  print(toStr(mix(1)(2, 3)))
  print("\n")
