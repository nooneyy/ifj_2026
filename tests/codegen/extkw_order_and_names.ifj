// a method is visible in the whole program, the same name can be defined
// for different types and a method can use another method of its receiver
// (spec 5.9) -> int 8|string ab
import ifj26.*

@main def main(): Unit =
  print(4.describe)
  print("|")
  print("ab".describe)
  print("\n")

extension (n: Int)
  def describe: String = "int " + n.twice.toString
  def twice: Int = n * 2

extension (s: String)
  def describe: String = "string " + s
