// length counts the characters of a String, escape sequences count as one
// character (spec 4, 5.4) -> 5, 0, 3, 8, 5, 10, 2
import ifj26.*

@main def main(): Unit =
  val s = "hello"
  val empty = ""
  print(s.length)
  print("\n")
  print(empty.length)
  print("\n")
  print("a\nb".length)
  print("\n")
  print("tab\there".length)
  print("\n")
  print(toStr(12345).length)
  print("\n")
  print((s + s).length)
  print("\n")
  print(subStr(s, 1, 3).length)
  print("\n")
