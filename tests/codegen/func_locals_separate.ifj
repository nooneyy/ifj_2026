// local variables and parameters of different functions don't interfere
// (spec 2.2, 2.3) -> 1 2 3
import ifj26.*

def g(x: Int): Int =
  val y = x + 1
  y

def h(): Int =
  val x = 3
  x

@main def main(): Unit =
  val x = 1
  val y = g(x)
  val z = h()
  print(x)
  print(" ")
  print(y)
  print(" ")
  print(z)
  print("\n")
