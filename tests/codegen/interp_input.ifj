// values that are known only at run time are inserted too, readLine keeps
// the line feed (spec 4, 5.6) -> 42 IFJ[new line]
import ifj26.*

@main def main(): Unit =
  val n = readInt()
  val name = readLine()
  print(s"${n * 2} $name")
