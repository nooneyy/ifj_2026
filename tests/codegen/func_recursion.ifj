// every call has its own local variables (spec 2.3) -> fib(15) = 610
import ifj26.*

def fib(n: Int): Int =
  if n < 2 then
    return n
  else
    val a = n - 1
    val b = n - 2
    val x = fib(a)
    val y = fib(b)
    return x + y

@main def main(): Unit =
  val r = fib(15)
  print(r)
  print("\n")
