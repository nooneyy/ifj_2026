// ! over && over ||, == and != on Boolean (spec 5.2)
import ifj26.*

@main def main(): Unit =
  val t = true
  val f = false
  val r1 = !t
  val r2 = t && f
  val r3 = t || f
  val r4 = !f && f || t
  val r5 = f || t && f
  val r6 = !(t && f)
  val r7 = t == f
  val r8 = t != f
  print(r1)
  print(" ")
  print(r2)
  print(" ")
  print(r3)
  print(" ")
  print(r4)
  print(" ")
  print(r5)
  print(" ")
  print(r6)
  print(" ")
  print(r7)
  print(" ")
  print(r8)
  print("\n")
