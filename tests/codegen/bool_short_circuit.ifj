// the right operand of && and || runs only when needed (spec 5.2, with
// FUNEXP for calls in expressions) -> false true !false !true
import ifj26.*

def side(r: Boolean): Boolean =
  print("!")
  r

@main def main(): Unit =
  val a = false && side(true)
  print(a)
  print(" ")
  val b = true || side(false)
  print(b)
  print(" ")
  val c = true && side(false)
  print(c)
  print(" ")
  val d = false || side(true)
  print(d)
  print("\n")
