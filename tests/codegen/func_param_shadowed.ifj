// a parameter acts as a local val, a sub-block can shadow it (spec 2.3)
// -> 100 5
import ifj26.*

def f(x: Int): Int =
  if x > 0 then
    val x = 100
    print(x)
  else
    print(x)
  x

@main def main(): Unit =
  val r = f(5)
  print(" ")
  print(r)
  print("\n")
