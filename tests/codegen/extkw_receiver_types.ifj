// methods of String, Double, Boolean and Int called on literals and on an
// expression in parentheses (spec 5.9, 5.4) -> hi!|2.50|false|14|42
import ifj26.*

extension (s: String)
  def shout: String = s + "!"
extension (d: Double)
  def half: Double = d / 2.0
extension (b: Boolean)
  def flip: Boolean = !b
extension (n: Int)
  def twice: Int = n * 2

@main def main(): Unit =
  print("hi".shout)
  print("|")
  print(5.0.half.toString)
  print("|")
  print(true.flip)
  print("|")
  print((3 + 4).twice)
  print("|")
  print(21.twice)
  print("\n")
