// direct and mutual recursion through several lists, empty ones among them
// (spec 2.3, 5.10) -> 120, true true, 321
import ifj26.*

def fact(n: Int)(acc: Int): Int = if n <= 1 then acc else fact(n - 1)(acc * n)
def isEven(n: Int)(): Boolean = if n == 0 then true else isOdd()(n - 1)
def isOdd()(n: Int): Boolean = if n == 0 then false else isEven(n - 1)()
def countdown(n: Int)(): Unit =
  if n > 0 then
    print(n)
    countdown(n - 1)()

@main def main(): Unit =
  print(fact(5)(1))
  print("\n")
  print(isEven(10)())
  print(" ")
  print(isOdd()(7))
  print("\n")
  countdown(3)()
  print("\n")
