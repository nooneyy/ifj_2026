// ord returns the ASCII code, -1 for an empty string or a wrong index
// (spec 4) -> 66 -1 -1 -1 97
import ifj26.*

@main def main(): Unit =
  val m = -1
  val a = ord("ABC", 1)
  val b = ord("", 0)
  val c = ord("abc", 3)
  val d = ord("abc", m)
  val e = ord("abc", 0)
  print(a)
  print(" ")
  print(b)
  print(" ")
  print(c)
  print(" ")
  print(d)
  print(" ")
  print(e)
  print("\n")
