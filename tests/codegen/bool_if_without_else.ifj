// else is optional, else if chains are allowed (spec 5.2)
// -> negative;zero;;
import ifj26.*

def classify(x: Int): Unit =
  if x < 0 then
    print("negative")
  else if x == 0 then
    print("zero")
  print(";")

@main def main(): Unit =
  val m = -5
  classify(m)
  classify(0)
  classify(5)
  print("\n")
