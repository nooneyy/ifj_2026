// only the first matching branch runs (spec 5.2) -> ABCF
import ifj26.*

def grade(n: Int): Unit =
  if n >= 90 then
    print("A")
  else if n >= 75 then
    print("B")
  else if n >= 50 then
    print("C")
  else
    print("F")

@main def main(): Unit =
  grade(95)
  grade(80)
  grade(50)
  grade(10)
  print("\n")
