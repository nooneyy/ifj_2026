// chains apply from the left; n.floor.toInt rounds down first, unlike n.toInt
// (spec 5.4) -> 3, -4, -3, 3!, 3.00, 4, 3abc, 2, 4, 3, 4, 2, 4, 4
import ifj26.*

@main def main(): Unit =
  val d = 3.7
  val n = -3.7
  val pi = 3.14159
  val s = "abc"
  val big = -123.5
  print(d.floor.toInt)
  print("\n")
  print(n.floor.toInt)
  print("\n")
  print(n.toInt)
  print("\n")
  print(d.toInt.toString + "!")
  print("\n")
  print(d.floor.toString)
  print("\n")
  print(pi.toString.length)
  print("\n")
  print(s.length.toString + s)
  print("\n")
  print("abcdefghijk".length.toString.length)
  print("\n")
  print(big.floor.toInt.toString.length)
  print("\n")
  print(s.toString.toString.length)
  print("\n")
  print((d + 1.0).toString.length)
  print("\n")
  print(().toString.length)
  print("\n")
  print(true.toString.length)
  print("\n")
  print(toStr(d.floor).length)
  print("\n")
