// -> 26|-7|2.50|1.23|0.00|6|6.50|IFJ|true|false|()|, 0x1.4p+1 2.50
import ifj26.*

@main def main(): Unit =
  val i = 26
  val m = -7
  val d = 2.5
  val s = "IFJ"
  val t = true
  val u: Unit = ()
  print(s"$i|$m|$d|${1.2345}|${0.001}|${i / 4}|${i / 4.0}|$s|$t|${i < 2}|$u|")
  print("\n")
  print(d)
  print(" ")
  print(s"$d")
  print("\n")
