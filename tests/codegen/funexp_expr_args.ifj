// any expression can be an argument, also with Int to Double conversion
// (spec 1.3, 5.1) -> 3 ab 6.0 2.0 1.5
import ifj26.*

def half(x: Double): Double = x / 2.0

@main def main(): Unit =
  print(1 + 2)
  print(" ")
  print("a" + "b")
  print(" ")
  print(2.0 * 3)
  print(" ")
  print(half(3 + 1))
  print(" ")
  print(1 + half(1))
  print("\n")
