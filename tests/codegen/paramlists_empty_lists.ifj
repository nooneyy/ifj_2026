// empty lists before, between and after the other lists (spec 5.10) -> 1 + 10 +
// 7 = 18, abcd
import ifj26.*

def none()(): Int = 1
def first()(a: Int): Int = a
def middle(a: Int)()(b: Int): Int = a - b
def last(a: String, b: String)(): String = a + b

@main def main(): Unit =
  print(none()() + first()(10) + middle(10)()(3))
  print("\n")
  print(last("ab", "cd")())
  print("\n")
