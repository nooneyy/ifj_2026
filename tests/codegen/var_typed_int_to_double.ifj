// an Int initialization or assignment of a Double variable is converted
// (spec 1.3, 2.2) -> 5.0, 2.0, 3.0, 4.0
import ifj26.*

@main def main(): Unit =
  val d: Double = 5
  print(d)
  print("\n")
  var e: Double = 1
  e = 2
  print(e)
  print("\n")
  val i = 3
  e = i
  print(e)
  print("\n")
  val f: Double = i + 1
  print(f)
  print("\n")
