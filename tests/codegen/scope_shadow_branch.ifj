// a branch may shadow an outer variable, the outer one is intact after
// the if (spec 2.2) -> 21
import ifj26.*

@main def main(): Unit =
  val x = 1
  if x == 1 then
    val x = 2
    print(x)
  else
    val x = 3
    print(x)
  print(x)
  print("\n")
