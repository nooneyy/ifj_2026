// the body of while is its own scope, redefined in every iteration
// (spec 2.2, 2.5) -> 01100
import ifj26.*

@main def main(): Unit =
  var i = 0
  val x = 100
  while i < 2 do
    val x = i
    print(x)
    i = i + 1
  print(x)
  print("\n")
