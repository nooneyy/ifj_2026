// readBoolean reads like READ with bool (spec 5.2) -> true false ok
import ifj26.*

@main def main(): Unit =
  val a = readBoolean()
  val b = readBoolean()
  print(a)
  print(" ")
  print(b)
  val nb = !b
  if a && nb then
    print(" ok")
  else
    print(" bad")
  print("\n")
