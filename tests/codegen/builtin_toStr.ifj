// toStr prints like print, but Double with "%.2f" (spec 4)
import ifj26.*

@main def main(): Unit =
  val m = -7
  val a = toStr(42)
  val b = toStr(m)
  val c = toStr(2.5)
  val d = toStr(1.2345)
  val e = toStr("abc")
  val f = toStr(())
  val g = toStr(0.001)
  print(a)
  print("|")
  print(b)
  print("|")
  print(c)
  print("|")
  print(d)
  print("|")
  print(e)
  print("|")
  print(f)
  print("|")
  print(g)
  print("|")
  print("\n")
