// an Int operand is converted when the other one is Double, Int / Int
// stays Int (spec 1.3, 3) -> 3.5, 1.5, 1.5, 3, 3.5, 5.5
import ifj26.*

@main def main(): Unit =
  val i = 3
  val a = i + 0.5
  val b = 0.5 * i
  val c = i / 2.0
  val d = 7 / 2
  val e = 7 / 2.0
  val f = i - 0.5 + i
  print(a)
  print("\n")
  print(b)
  print("\n")
  print(c)
  print("\n")
  print(d)
  print("\n")
  print(e)
  print("\n")
  print(f)
  print("\n")
