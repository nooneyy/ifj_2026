// toInt cuts off the decimal part (spec 4) -> 3 -3 0 1000
import ifj26.*

@main def main(): Unit =
  val n = -3.99
  val a = toInt(3.99)
  val b = toInt(n)
  val c = toInt(0.5)
  val d = toInt(1e3)
  print(a)
  print(" ")
  print(b)
  print(" ")
  print(c)
  print(" ")
  print(d)
  print("\n")
