// < <= > >= == != over Int in conditions (spec 3) -> T/F for each
import ifj26.*

@main def main(): Unit =
  val a = 3
  val b = 5
  if a < b then
    print("T")
  else
    print("F")
  if a <= b then
    print("T")
  else
    print("F")
  if a > b then
    print("T")
  else
    print("F")
  if a >= b then
    print("T")
  else
    print("F")
  if a == b then
    print("T")
  else
    print("F")
  if a != b then
    print("T")
  else
    print("F")
  if a <= a then
    print("T")
  else
    print("F")
  if a >= a then
    print("T")
  else
    print("F")
  if a == a then
    print("T")
  else
    print("F")
  if a < a then
    print("T")
  else
    print("F")
  print("\n")
