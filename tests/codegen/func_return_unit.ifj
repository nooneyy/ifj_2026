// a bare return ends a Unit function (spec 2.3) -> negpos!
import ifj26.*

def show(x: Int): Unit =
  if x < 0 then
    print("neg")
    return
  else
    print("pos")
  print("!")

@main def main(): Unit =
  val m = -1
  show(m)
  show(1)
  print("\n")
