import ifj26.*
def area(w: Double, h: Double): Double = w * h // one-line body
def greet(name: String) = "Hi " + name + "\t\"//\"\n" // inferred String
def fib(n: Int): Int =
  if n <= 1 then
    return n
  else
    val a = n - 1; val b = n - 2
    val fa = fib(a); val fb = fib(b)
    return fa + fb
def show(msg: String, times: Int): Unit =
  var i = 0
  while i < times do
    print(msg); i = i + 1
  if times == 0 then
    return
  else
    ()

@main
