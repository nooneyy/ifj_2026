// one-line interpolated strings (INTERPOLATEDS): $id, ${expr}, $$ as one '$',
// plain text and the spec example -> 0
import ifj26.*
@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  print(s"$name${n + 1} costs $$0")
  val empty = s""; val plain = s"no interpolation"
  val first = s"$name is first"; val last = s"last is $name"
  val dot = s"$name."; val twice = s"$name$name"; val under = s"$_x and $n_2"
  val only = s"${n}"; val dollars = s"$$$$ and $$name"
  val spaced = s"spaced ${ n * 2 } out"
  val notInterp = "$name ${n} stays text in a normal string"
  val s = "x"; val t = s + s"$s"
