// Int test: 0x1F 0123 1__0 inside a comment must be ignored
import ifj26.*
def add(a: Int, b: Int): Int = a + b
def sum3(
  x: Int, y: Int,
  z: Int,
  ): Int = x + y + z
def factorial(n: Int): Int =
  if n <= 1 then
    return 1
  else
    val m = n - 1; val rest = factorial(m)
    return n * rest
@main def main(): Unit =
  val zero = 0; val ten = 1_0; val _9 = 9
  val max = 2_147_483_647; val min = -2147483647 - 1
  var i: Int = -0; val mixed: Double = 42
  val expr = -(3 - 10) * (2 + -1) + 1 + 2 * 3 - 4 / 2 - -7 / 2
  val total = sum3(1_000,
    min,
    max)
  val fact = factorial(ten); val code = ord("12345", 0)
  val part = subStr("abcdef", zero, 3); val n = readInt()
  while i < ten do
    i = add(i, 1)
  if n >= i then
    print(n)
  else
    print(min)
