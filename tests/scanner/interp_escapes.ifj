// escape sequences work in one-line interpolated strings the same way as in
// normal strings, a double quote is written as \" -> 0
import ifj26.*
@main def main(): Unit =
  val name = "IFJ"
  print(s"He said \"$name\"\n")
  print(s"tab\there, backslash \\ and \r")
  print(s"\"${name}\"")
