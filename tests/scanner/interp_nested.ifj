// an interpolated string is an expression too, so it can be inside ${ } of
// another interpolated string -> 0
import ifj26.*
@main def main(): Unit =
  val x = 1
  print(s"outer ${ s"inner $x" } outer")
  print(s"a ${ s"b ${ s"c $x" }" } d")
  print(s"""multi ${ s"one" } line""")
  print(s"${ s"" }")
  print(s"" + s"${x}")
