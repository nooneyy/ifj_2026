/* comment before the prolog /* nested /* twice */ */ still inside */
// line comment before the prolog with "quotes" and /* an opener
    /* indented, block comment only line */
import ifj26.* // comment right after the prolog
def twice(n: Int): Int = // comment after the header ends the line
  n /**/*/**/ 2 // empty comments around * act as whitespace: n * 2
def pick(a: Int, // comment inside parentheses, before a line break
    // a comment-only line inside the parentheses
    b: Int): Int =
  /* block comment
     spanning lines */
  if a > b then // comment after then
    return a /* one-line block */
  else /* nested /* at the end */ */
    return b

/* This tests a comment spanning multiple lines in parentheses */
def multiLineCommentInParens(x: String, /* hello
world */ b: Int
  ) =
    print("hello world!")

def multiLineCommentInParensArgOnSeparateLine(x: String, /* hello
world */
  b: Int
  ) =
      print("hello world 2!")

def random() =
  twice(twice(/* multi-line comment in multiple levels of
  parentheses */))

@main /* comment between @main and def */
def main(): Unit =
  val/**/x/**/=/**/5 // block comments as the only separators
  val y /* before the type */ : Int = - /* inside unary minus */ 3
  val s = "/* not a comment */ // nor this"; val z = twice(x) /* ; inside */
  val m = pick(x, /* between arguments */ y); var i = 0 /**/
  /*/ the slash after the opener does not close it **/
      // deeper indented comment-only line does not cause INDENT
// comment at column 0 does not cause DEDENT
  while i < m do /* comment after do */
    i = i + 1 /* a multi-line comment
      acts as the end of this line */ // and may be followed by a comment
  print(s) // comment with "unbalanced quote and */ closer
  print(z) // last line ends with a comment, no newline at end of file