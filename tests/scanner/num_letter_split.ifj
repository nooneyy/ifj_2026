// a letter right after a complete number ends the number and starts an
// identifier (12abc is INT 12 + ID abc), the parser then rejects it -> 0
import ifj26.*
@main def main(): Unit =
  val a = 12abc
  val b = 1.5abc
  val c = 1e5abc
  val d = 0abc
  val e = 1_000abc
