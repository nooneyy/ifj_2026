// multi-line interpolated strings: the double quote is written literally,
// line ends belong to the text and lines are still counted -> 0
import ifj26.*
@main def main(): Unit =
  val name = "IFJ"
  val n = 26
  print(s"""He said "hello"
, $name.
Second line.
""")
  val empty = s""""""
  val quotes = s"""""$name"" ${n}"""
  val lines = s"""$n
${n +
      1}
$$"""
  print(name)
