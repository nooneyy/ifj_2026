// For test: for i <- 0 until 10 in a comment must be ignored
import ifj26.*
@main def main(): Unit =
  for i <- 1 to 10 by 2 do
    print(i)
  val limit = 10
  for
    i <- 0 until limit
    if i != 3
    if i < 8
  do
    print(i)
  for j<-1 to 3 do print(j)
  // "to", "until" and "by" are identifiers, not keywords
  val until = 5; val by = 2; val to = 0
  for k <- to to until by by do
    print(k)
  val a = 0 - 3
  val neg = a < -1
  val le = a <=-1
  val s = "x <- y"
  if neg && le then
    print(s)
