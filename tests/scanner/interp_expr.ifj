// ${ } holds any expression: operators, parentheses, normal strings and
// function calls (FUNEXP) -> 0
import ifj26.*
@main def main(): Unit =
  val a = 1; val b = 2.5
  print(s"sum: ${a + b * (a - 3)}")
  print(s"${a}${b}")
  print(s"cmp ${a < 2} and str ${"inner " + "text"}")
  print(s"call ${toStr(a)} and ${-a}")
