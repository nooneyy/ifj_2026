// String test: "quotes", \n and /* in a comment */ are ignored
import ifj26.*
def greet(name: String): String = "Hello, " + name + "!"
def wrap(s: String): String =
  val q = "\""
  return q + s + q
@main def main(): Unit =
  val empty = ""; val esc = "\t\r\n\\\""; val bs = "\\n is not a newline"
  val tricky = "// not a comment /* nor this */ def @main 1.5e3"
  val tab = "real	tab"; var acc: String = ""
  val raw = """first line
  "quoted" and ""double"" \n stays two chars
"""
  val emptyRaw = """"""; val endsQuote = """ends with a quote""""
  val g = greet(empty); val w = wrap(tricky); val n = toStr(42)
  val len = strLength(esc); val part = subStr("abcdef", 0, 1)
  val code = ord("A", 0); val letter = chr(code); val line = readLine()
  var count = 0
  while count < 3 do
    acc = acc + letter + "-"
    count = count + 1
  if "apple" < "banana" then
    print(acc)
  else
    print(empty)
  if line != "" then
    print(line)
  else
    print("""multi-line
  string argument""")
